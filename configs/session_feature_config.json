    "session_duration_minutes_standardized",
    "app_name_one_hot"
  ],
  "numeric_features": [
    "data_consumed_mb",
    "session_duration_minutes"
  ],
  "categorical_features": [
    "app_name"
  ],
  "app_name_labels": [
