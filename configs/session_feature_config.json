    "customer_id",
    "app_category",
    "hour",
    "time_of_day",
    "is_night",
    "day_of_week",
    "is_weekend",
    "operator",
    "network_type",
    "timestamp",
    "usage_date",
    "day_of_month",
    "month"
  ],
  "validation": {
    "rows_preserved": true,
    "distinct_session_ids_preserved": true,
    "vector_length": true,
    "no_nulls": true,
    "no_nan_or_inf": true,
